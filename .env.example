# ------------------------------------------------------------------
# Copia este archivo como .env y llena tus claves. El .env NO se sube a GitHub.
# (En GitHub van en Settings > Secrets and variables > Actions.)
# ------------------------------------------------------------------

# Token gratis de Travelpayouts (Profile > API token)
TRAVELPAYOUTS_TOKEN=

# Gmail que manda los emails (yasuiflights@gmail.com) y su App Password (16 letras)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Supabase (Project Settings > API Keys)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Link de la página en GitHub Pages (sale en los emails)
SITE_URL=

# Solo sin Supabase (modo local): a quién le llegan TODAS las ofertas, separados por coma
EMAIL_TO=
